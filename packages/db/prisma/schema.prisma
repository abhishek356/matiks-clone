// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id  String  @id   @default(uuid()) 
  email   String    @unique
  password    String 
  username  String    @unique
  rating    UserRating?
  gameMember GameMember[]
  sender      Friends[]  @relation("sender")
  receiver    Friends[]  @relation("receiver")
  answers  QuestionAnswer[]

}


model Game {
  id   String    @id    @default(uuid())
  timeLimit    Int
  startedAt    DateTime
  endedAt      DateTime
  gameMember  GameMember[]
  questions  Question[]
  answers  QuestionAnswer[]


}


model UserRating  {
  id   String  @id  @default(uuid())
  userId  String  @unique

  user   User  @relation(references:[id], fields:[userId])
}

model  GameMember {
  id      String    @id  @default(uuid())
  gameId  String
  game    Game  @relation(references:[id], fields:[gameId])
  userId  String
  user User  @relation(references:[id], fields:[userId])
}

enum FriendStatus {
  pending
  accepted
  rejected
}

enum QuestionSign {
  plus
  minus
  multiply
  divide
}

model  Friends {
  id  String  @id   @default(uuid())
  status  FriendStatus  @default(pending)
  receiverId   String 
  receiver     User     @relation("receiver",references:[id], fields:[receiverId])
  senderId     String  
  sender       User     @relation("sender",references:[id], fields:[senderId])
}

model Question  {
  id String  @id   @default(uuid())
  gameId  String
  game    Game  @relation(references:[id], fields:[gameId])
  systemAnswer  Int
  operation1  Int
  operation2  Int
  sign  QuestionSign
  answers  QuestionAnswer[]
}

model QuestionAnswer {

id String  @id @default(uuid())
questionId  String
question  Question  @relation(references:[id], fields:[questionId])
answer  Int
gameId String
userId String  
game  Game  @relation(references:[id], fields:[gameId])
user User  @relation(references:[id], fields:[userId])
}